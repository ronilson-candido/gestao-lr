# Supabase — copie este arquivo para `.env.local` e preencha os valores.
# Obtenha em: https://app.supabase.com/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sua-publishable-key-aqui

# NUNCA exponha esta chave no frontend ou em repositório público.
# Use SOMENTE em variáveis de ambiente do servidor (se necessário em scripts admin).
# SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-apenas-servidor
